NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sólo servidor. Sin valor, el sitio funciona con datos de demostración.
DATABASE_URL=
# Carpeta de fotos y archivos del contenido, publicada en /media. Sin valor: ./media.
# En la VPS va fuera de las versiones: MEDIA_DIR=/srv/agenda/media
MEDIA_DIR=
# Firma de las sesiones del panel. Obligatoria en producción: openssl rand -base64 48
SESION_SECRETO=
# Backend de Migue para el chat del sitio. Sin valor, una compilación de producción usa
# https://migue.smt.gob.ar y en desarrollo no hay chat; "no" lo apaga.
NEXT_PUBLIC_MIGUE_URL=
